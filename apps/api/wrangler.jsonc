{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agrosense",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": { "enabled": true }
}
