# Copy to apps/api/.env for Wrangler local development. Never commit .env.
# Exact production Pages origin. Leave blank locally when using Vite's proxy.
CORS_ORIGIN=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Server administration and the agent's owner-scoped reads. Never use in Vite.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Manual Kapso outbound WhatsApp; all three are required for the manual endpoint.
# Keep the project API key server-side. See docs/kapso.md.
KAPSO_API_KEY=
# Sender's numeric Meta phone number ID, not its telephone number.
KAPSO_PHONE_NUMBER_ID=
# Supabase Auth operator UUID; also owns the farms accessible to the agent.
KAPSO_ALLOWED_USER_ID=
# Shared signing secret for the phone-number Kapso v2 webhook (at least 16 chars).
# /api/whatsapp/webhook receives incoming messages and notification delivery receipts.
KAPSO_WEBHOOK_SECRET=

# Inbound reasoning agent; disabled until all settings are supplied.
# See docs/whatsapp-agent.md. Never put these values in Vite variables.
# This flag stops conversation admission/run/send; signed receipts remain active.
WHATSAPP_AGENT_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_REASONING_EFFORT=medium

# Automatic monitoring: Supabase Cron invokes authenticated Worker jobs.
# 64 random lowercase hex characters; use the same secret in Supabase Vault.
AUTOMATION_CRON_SECRET=
# Text notifications reuse KAPSO_API_KEY and KAPSO_PHONE_NUMBER_ID; recipients are stored in Supabase.
# Delivery receipts use the shared KAPSO_WEBHOOK_SECRET above.
# Optional commercial Open-Meteo key; selects customer-api.open-meteo.com.
OPEN_METEO_API_KEY=
# Optional Sentinel-2 previews; server only.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
